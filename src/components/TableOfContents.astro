---
import ChevronIcon from "@/assets/icons/callouts/alt-arrow-down.svg"
import type { MarkdownHeading } from "astro"

type Section = {
  id?: string
  label: string
  open?: boolean
  headings: MarkdownHeading[]
}
type Props = { title: string; sections: Section[] }

const { title, sections } = Astro.props
---

<nav aria-label="Table of contents">
  <toc-title aria-hidden="true">{title}</toc-title>
  <button type="button" data-bar popovertarget="toc-list">
    <svg viewBox="0 0 16 16" aria-hidden="true">
      <circle cx="8" cy="8" r="6.5" />
      <circle cx="8" cy="8" r="6.5" transform="rotate(-90 8 8)" />
    </svg>
    <toc-current>{title}</toc-current>
    <ChevronIcon aria-hidden="true" />
  </button>
  <ul data-bar id="toc-list" popover>
    {sections.map(({ id, label, open, headings }) =>
        id ? (
          <li data-group>
            <a href={`#${id}`}>{label}</a>
            {headings.length > 0 && (
              <details open={open || undefined}>
                <summary aria-label={`Sections of ${label}`}>
                  <ChevronIcon aria-hidden="true" />
                </summary>
                <ul>
                  {headings.map(({ depth, slug, text }) => (
                    <li data-depth={depth}>
                      <a href={`#${slug}`}>{text}</a>
                    </li>
                  ))}
                </ul>
              </details>
            )}
          </li>
        ) : (
          headings.map(({ depth, slug, text }) => (
            <li data-depth={depth}>
              <a href={`#${slug}`}>{text}</a>
            </li>
          ))
        ),
      )}
  </ul>
</nav>

<style>
  nav {
    display: flex;
    flex-direction: column;
    max-height: 100%;
    font-size: var(--step--1);

    @media (width < 64rem) {
      max-height: none;
    }
  }

  toc-title {
    display: block;
    flex-shrink: 0;
    margin-block-end: var(--space-2xs);
    font-weight: var(--font-weight-medium);

    &:not([data-visible]) {
      display: none;
    }

    @media (width < 64rem) {
      display: none;
    }
  }

  button {
    display: none;

    @media (width < 64rem) {
      display: flex;
      align-items: center;
      gap: var(--space-2xs);
      inline-size: 100%;
      text-align: start;
      cursor: pointer;

      &:focus-visible {
        outline-offset: -2px;
        border-radius: 0;
      }

      > svg:first-of-type {
        flex-shrink: 0;
        inline-size: 1em;
        block-size: 1em;

        circle {
          fill: none;
          stroke: var(--border);
          stroke-width: 2;

          &:last-child {
            --circumference: calc(2 * pi * 6.5px);

            stroke: var(--muted-foreground);
            stroke-dasharray: var(--circumference);
            stroke-dashoffset: var(--circumference);

            @supports (animation-timeline: scroll()) {
              animation-name: toc-progress;
              animation-duration: auto;
              animation-timing-function: linear;
              animation-fill-mode: both;
              animation-timeline: scroll(root);
            }
          }
        }
      }

      toc-current {
        flex: 1;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: var(--muted-foreground);
      }

      > svg:last-of-type {
        flex-shrink: 0;
        inline-size: 1em;
        block-size: 1em;
        color: var(--muted-foreground);
      }
    }
  }

  nav:has(> ul:popover-open) > button > svg:last-of-type {
    rotate: 180deg;
  }

  nav > ul {
    min-height: 0;
    inline-size: auto;
    block-size: auto;
    color: inherit;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }

    @media (width >= 64rem) {
      position: static;
      background-color: transparent;
    }

    @media (width < 64rem) {
      inset-block: calc(var(--bar-nav-height) + var(--bar-toc-height)) auto;
      max-block-size: 30svh;

      &:not(:popover-open) {
        display: none;
      }
    }
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);

    a {
      color: var(--muted-foreground);

      &:hover,
      &[data-active] {
        color: var(--foreground);
      }
    }

    li[data-group] {
      position: relative;
      font-weight: var(--font-weight-medium);

      &:not(:first-child) {
        margin-block-start: var(--space-2xs);
      }

      > a {
        display: block;
      }

      &:has(> details) > a {
        padding-inline-end: 1.75rem;
      }

      &:has(details:not([open]) a[data-active]) > a {
        color: var(--foreground);
      }

      summary {
        position: absolute;
        inset-block-start: 0;
        inset-inline-end: 0;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        inline-size: 1.5rem;
        block-size: 1lh;
        color: var(--muted-foreground);
        cursor: pointer;
        list-style: none;

        &::-webkit-details-marker {
          display: none;
        }

        &:hover {
          color: var(--foreground);
        }

        svg {
          inline-size: 1em;
          block-size: 1em;
        }
      }

      details[open] > summary svg {
        rotate: 180deg;
      }

      details > ul {
        --shift: 1;

        margin-block-start: var(--space-3xs);
        font-weight: var(--font-weight-normal);
      }
    }

    li[data-depth] {
      padding-inline-start: calc(
        (var(--shift, 0) + var(--indent, 0)) *
        var(--space-xs)
      );
    }

    li[data-depth="3"] {
      --indent: 1;
    }

    li[data-depth="4"] {
      --indent: 2;
    }
  }

  @keyframes toc-progress {
    to {
      stroke-dashoffset: 0;
    }
  }
</style>

<script>
  import { hashId } from "@/lib/utils"

  ;(() => {
    const nav = document.querySelector<HTMLElement>("page-toc nav")
    if (!nav) return

    const seen = new Map<string, number>()
    const links = new Map<Element, HTMLAnchorElement>()
    for (const a of nav.querySelectorAll<HTMLAnchorElement>("a[href^='#']")) {
      const id = hashId(a.hash)
      const nth = seen.get(id) ?? 0
      seen.set(id, nth + 1)
      const target = document.querySelectorAll(`[id="${CSS.escape(id)}"]`)[nth]
      if (target) links.set(target, a)
    }
    const articles = document.querySelectorAll("main article")
    const list = nav.querySelector<HTMLElement>(":scope > ul")
    const title = nav.querySelector("toc-title")
    const currentLabel = nav.querySelector("toc-current")
    const heading = document.querySelector("article > header h1")
    if (articles.length === 0 || !list || links.size === 0) return

    const fallback = currentLabel?.textContent ?? ""

    const scrollPaddingTop =
      Number.parseFloat(
        getComputedStyle(document.documentElement).scrollPaddingBlockStart,
      ) || 0

    const groups = [
      ...nav.querySelectorAll<HTMLDetailsElement>("li[data-group] details"),
    ].map((details) => ({
      details,
      active: details.open,
      anchors: [
        ...(details.parentElement?.querySelectorAll<HTMLAnchorElement>(
          "a[href^='#']",
        ) ?? []),
      ],
    }))

    const blockOf = new Map<Element, Element>()
    for (const target of links.keys()) {
      const block = target.closest("prose-content > *, article[data-url]")
      if (block && !blockOf.has(block)) blockOf.set(block, target)
    }

    const sectionOf = new Map<Element, Element>()
    for (const article of articles) {
      let current = blockOf.get(article)
      for (const child of article.children) {
        if (child.tagName === "PROSE-CONTENT") {
          for (const block of child.children) {
            current = blockOf.get(block) ?? current
            if (current) sectionOf.set(block, current)
          }
        } else if (current) sectionOf.set(child, current)
      }
    }

    const visible = new Set<Element>()
    let prevActive = new Set<Element>()

    const center = () => {
      const run = [
        ...list.querySelectorAll<HTMLAnchorElement>("a[data-active]"),
      ]
      const first = run[0]
      const last = run[run.length - 1]
      if (!first || !run.every((a) => a.checkVisibility())) return
      const area = list.getBoundingClientRect()
      const runCenter =
        (first.getBoundingClientRect().top +
          last.getBoundingClientRect().bottom) /
        2
      list.scrollTo({
        top: list.scrollTop + runCenter - (area.top + area.height / 2),
      })
    }

    list.addEventListener("toggle", (event) => {
      if ((event as ToggleEvent).newState === "open") center()
    })
    list.addEventListener("click", (event) => {
      if ((event.target as Element).closest?.("a")) list.hidePopover()
    })

    const observerOptions = {
      rootMargin: `-${scrollPaddingTop}px 0px 0px`,
    }
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.target === heading) {
          const past = !entry.isIntersecting
          title?.toggleAttribute("data-visible", past)
        } else if (entry.isIntersecting) visible.add(entry.target)
        else visible.delete(entry.target)
      }

      const activeTargets = new Set<Element>()
      for (const block of visible) {
        const target = sectionOf.get(block)
        if (target) activeTargets.add(target)
      }

      let firstActive: HTMLAnchorElement | undefined
      for (const [target, link] of links) {
        const on = activeTargets.has(target)
        link.toggleAttribute("data-active", on)
        link.removeAttribute("aria-current")
        if (on) firstActive ??= link
      }
      firstActive?.setAttribute("aria-current", "location")

      if (currentLabel) {
        const label = firstActive?.textContent?.trim() || fallback
        if (currentLabel.textContent !== label) currentLabel.textContent = label
      }

      for (const group of groups) {
        const active = group.anchors.some((a) => a.hasAttribute("data-active"))
        if (active !== group.active) {
          group.active = active
          if (active) group.details.open = true
        }
      }

      let grew = false
      for (const target of activeTargets) {
        if (!prevActive.has(target)) {
          grew = true
          break
        }
      }
      prevActive = activeTargets
      if (grew) center()
    }, observerOptions)

    for (const block of sectionOf.keys()) observer.observe(block)
    if (heading) {
      observer.observe(heading)
    } else {
      title?.toggleAttribute("data-visible", true)
    }
  })()
</script>
