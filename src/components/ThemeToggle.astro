---
import MoonIcon from "@/assets/icons/moon.svg"
import SunIcon from "@/assets/icons/sun.svg"
---

<button id="theme-toggle" data-icon-button>
  <light-icon>
    <SunIcon role="img" aria-label="Switch to dark theme" />
  </light-icon>
  <dark-icon>
    <MoonIcon role="img" aria-label="Switch to light theme" />
  </dark-icon>
</button>

<style is:global>
  :root:has(> head > meta[name="color-scheme"][content="light"]) {
    color-scheme: light;
  }

  dark-icon {
    display: none;
  }

  :root:has(> head > meta[name="color-scheme"][content="dark"]) {
    color-scheme: dark;

    light-icon {
      display: none;
    }

    dark-icon {
      display: inline;
    }
  }

  @media (prefers-color-scheme: dark) {
    :root:has(> head > meta[name="color-scheme"][content="light dark"]) {
      light-icon {
        display: none;
      }

      dark-icon {
        display: inline;
      }
    }
  }
</style>

<script>
  const scheme = document.querySelector<HTMLMetaElement>(
    'meta[name="color-scheme"]',
  )

  const toggleTheme = () => {
    if (!scheme) return
    const system = matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light"
    const current = scheme.content === "light dark" ? system : scheme.content
    const theme = current === "dark" ? "light" : "dark"
    if (theme === system) {
      scheme.content = "light dark"
      localStorage.removeItem("theme")
    } else {
      scheme.content = theme
      localStorage.theme = theme
    }
  }

  const button = document.getElementById("theme-toggle")
  if (button) button.onclick = toggleTheme
</script>
