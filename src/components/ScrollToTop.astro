---
import ArrowUp from "@/assets/icons/arrow-up.svg"

type Props = { floating?: boolean }

const { floating } = Astro.props
---

<button
  data-icon-button
  data-scroll-top
  data-floating={floating || undefined}
  aria-label="Scroll to top"
>
  <ArrowUp />
</button>

<style>
  button {
    color: var(--foreground);

    @supports (animation-timeline: scroll()) {
      visibility: hidden;
      animation-name: scroll-top-reveal;
      animation-duration: auto;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root);
      animation-range: 50vh calc(50vh + 1px);
    }
  }

  @keyframes scroll-top-reveal {
    to {
      visibility: visible;
    }
  }

  button:not([data-floating]) {
    @media (width < 64rem) {
      display: none;
    }
  }

  button[data-floating] {
    position: fixed;
    inset-block-end: var(--grid-gutter);
    inset-inline-end: var(--grid-gutter);
    z-index: 10;
    width: 2.5rem;
    height: 2.5rem;
    background-color: color-mix(in oklab, var(--background) 90%, transparent);
    backdrop-filter: blur(var(--blur-sm));
    border: 1.5px solid var(--border);
    border-radius: var(--radius-md);

    @media (width >= 64rem) {
      display: none;
    }
  }
</style>

<script>
  document.addEventListener("click", (event) => {
    if ((event.target as Element).closest("[data-scroll-top]"))
      window.scrollTo({ top: 0 })
  })
</script>
